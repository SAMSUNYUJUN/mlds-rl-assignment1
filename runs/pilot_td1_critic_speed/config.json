{
  "algorithm": "PPO-Clip",
  "game": "cartpole",
  "environment": "CartPole-v1",
  "seed": 91,
  "total_steps": 8192,
  "device": "cpu",
  "hidden": 64,
  "gamma": 0.95,
  "gae_lambda": 0.95,
  "clip_ratio": 0.2,
  "actor_lr": 0.0003,
  "critic_lr": 0.001,
  "adam_eps": 1e-08,
  "epochs": 10,
  "minibatch_size": 256,
  "rollout_steps": 2048,
  "num_envs": 8,
  "grad_clip": 0.5,
  "entropy_coef": 0.0,
  "normalize_advantage": true,
  "advantage_std_ddof": 0,
  "train_seed_base": 9100000,
  "eval_seed_base": 80000000,
  "action_sampling": "categorical via independent per-episode NumPy RNG",
  "time_limit_bootstrap": true,
  "observation_normalization": false,
  "reward_normalization": false,
  "value_loss": "0.5 * mean squared error",
  "value_target": "one-step TD: reward + gamma * (1-terminated) * frozen old next-state value",
  "objective": "uniform-transition PPO clipped surrogate; no absolute gamma^t",
  "termination": "natural failure or official 500-step TimeLimit",
  "actor_initialization": "same Policy constructor and torch seed as REINFORCE",
  "critic_target": "td1"
}
